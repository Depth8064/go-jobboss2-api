# Copy this file to a local untracked file (example: .env.live) and fill secrets.
# Smoke tool only uses GET endpoints.

# Required
JB2_CLIENT_ID=
JB2_CLIENT_SECRET=

# Optional (defaults to ECI integration hosts when empty)
JB2_BASE_URL=https://api-jb2.integrations.ecimanufacturing.com
JB2_TOKEN_URL=https://api-user.integrations.ecimanufacturing.com/oauth2/api-user/token
JB2_SCOPE=openid

# Optional runtime controls
JB2_TIMEOUT_SEC=20
JB2_TAKE=5

# Optional comma-separated checks
# Available values:
# company,currency-codes,departments,employees,work-centers,customers,vendors,tax-codes,terms
JB2_CHECKS=company,currency-codes,departments,employees,work-centers
